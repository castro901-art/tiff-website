{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "^www\\.tiff\\.co\\.ke$"
        }
      ],
      "destination": "https://tiff.co.ke/",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "^www\\.tiff\\.co\\.ke$"
        }
      ],
      "destination": "https://tiff.co.ke/:path",
      "permanent": true
    }
  ]
}
